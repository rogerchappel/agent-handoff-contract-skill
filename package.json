{
  "name": "agent-handoff-contract-skill",
  "version": "0.1.0",
  "description": "Validate agent-to-agent handoff notes for ownership, approvals, blockers, and evidence.",
  "type": "module",
  "bin": {
    "handoff-contract": "./src/cli.js"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check src/index.js && node --check src/cli.js",
    "smoke": "node src/cli.js fixtures/complete.md --format markdown",
    "package:smoke": "node scripts/package-smoke.js",
    "release:check": "npm run check && npm test && npm run smoke && npm run package:smoke",
    "validate": "bash scripts/validate.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/agent-handoff-contract-skill.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/agent-handoff-contract-skill/issues"
  },
  "homepage": "https://github.com/rogerchappel/agent-handoff-contract-skill#readme",
  "files": [
    "src",
    "scripts",
    "fixtures",
    "docs",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "agent-skill",
    "handoff",
    "contract",
    "workflow"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
